# Puerto de la API
PORT=8787

# Secreto para firmar tokens de sesión (cámbialo en producción)
SESSION_SECRET=cambia-este-secreto-largo-y-aleatorio

# Duración de sesión en días (por defecto 3)
SESSION_DAYS=3

# OTP válido durante N minutos
OTP_TTL_MINUTES=10

# Ruta al archivo de correos permitidos (relativa a api/ o absoluta)
ALLOWED_EMAILS_FILE=../allowed_emails.txt

# --- SMTP (obligatorio para enviar OTP real) ---
# Gmail: usa "Contraseña de aplicación" en cuenta Google
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu-correo@gmail.com
SMTP_PASS=tu-app-password
SMTP_FROM="TerminalMX <tu-correo@gmail.com>"

# Origenes permitidos (CORS), separados por coma
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,https://TU_USUARIO.github.io

# Si true, no envía correo y el OTP se imprime en la consola del servidor (solo desarrollo)
DEV_LOG_OTP=true
